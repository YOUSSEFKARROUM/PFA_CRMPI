      "options": {
        "1": "Non",
        "2": "Ad-hoc (1x/an)",
        "3": "Annuel",
        "4": "Tri-mensuel (4x/an) + feedback",
        "5": "Mensuel + tableaux de bord + incitations"
      }
    },
    {
      "id": "q25",
      "domain": "Sensibilisation & Formation",
      "order": 25,
      "text": "Avez-vous une politique de télétravail sécurisée (VPN chiffré, antivirus)?",
