      "options": {
        "1": "Non",
        "2": "VPN basique (ancien)",
        "3": "VPN chiffré (TLS/IPSec)",
        "4": "VPN + antivirus obligatoire + MFA",
        "5": "VPN + MFA + vérification conformité poste"
